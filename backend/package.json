{
  "name": "taskorbit-backend",
  "version": "1.0.0",
  "description": "TaskOrbit Jira Clone Backend",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "start": "node dist/index.js",
    "db:create": "ts-node scripts/create-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:setup": "npm run db:create && prisma migrate dev && npx prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:build-schema": "ts-node scripts/build-schema.ts",
    "seed": "tsx prisma/seed/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.2",
    "pg": "^8.20.0",
    "tsup": "^8.5.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
